meta {
  name: getUserAppointments
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/appointments/me
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{customerAccessToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}
